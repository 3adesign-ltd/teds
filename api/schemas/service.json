{
    "type": "object",
    "required": [
        "type",
        "api_version"
    ],
    "properties": {
        "type": {
            "type": "string",
            "const": "urn:x-teds:service"
        },
        "api_version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "service_version": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "contract_version": {
            "type": "string",
            "description": "The tag contract version (contract.md §3)."
        },
        "role_vocabulary_version": {
            "type": "string",
            "description": "The role vocabulary version (contract.md §4)."
        }
    }
}
